# Copiar para .env e preencher. Nunca fazer commit do .env.

# --- Connected Home MCP (Altice) ---
CONNECTED_HOME_MCP_URL=https://cognitive-home.futurelabsinnovations.com
CONNECTED_HOME_API_KEY=
# CONNECTED_HOME_CALLBACK_PORT=5434

# --- LLM (qualquer endpoint compativel com a API da OpenAI) ---
# Servidor da equipa na rede: modelos em http://192.168.2.161:1234/v1/models
# Cloud: URL e chave do fornecedor
LLM_BASE_URL=http://192.168.2.161:1234/v1
LLM_MODEL=qwen3.8:latest
LLM_API_KEY=
# LLM_REASONING_EFFORT=none   # none = sem raciocínio (~1 s com o qwen3.8); low|medium|high; vazio = não enviar

# --- Visão / Câmara (fora do MCP) ---
VISION_ENABLED=true
CAMERA_RTSP_URL=                    # vazio = usa FileFrameSource (simulação); rtsp://... ou webcam:0
# VISION_BASE_URL=                  # vazio = herda LLM_BASE_URL
# VISION_MODEL=                     # vazio = herda LLM_MODEL (qwen3.8:latest)
# VISION_API_KEY=                   # vazio = herda LLM_API_KEY
# VISION_TIMEOUT_S=25
# VISION_COOLDOWN_S=10              # cooldown padrão (AWAY e alarmes)
# VISION_STAY_COOLDOWN_S=30         # cooldown para camera_motion em STAY
# VISION_TRIGGER_DISARMED=false     # true apenas para testes/demos rápidas sem armar a casa
# VISION_SIM_IMAGE=                 # opcional: caminho de imagem para FileFrameSource
# VISION_MAX_FRAMES=50              # retenção máxima de snapshots em var/frames/
# VISION_FRAMES_DIR=                # vazio = var/frames/ (gitignored)

# --- Modos ---
DRY_RUN=true        # false = o Coordenador escreve mesmo na casa real (MCP)
SIMULATE=false
SIM_ROOMS=false     # true = junta as divisões simuladas de config/home.json à casa real

# --- Perceção (opcional; valores por omissão) ---
# POLL_INTERVAL_S=7          # 2 em SIMULATE
# TICK_INTERVAL_S=90
# TEMP_DROP_C=0.5
# TEMP_DROP_WINDOW_S=600
# SMOKE_ALARM_TYPES=EMERGENCY,SMOKE,FIRE   # hipótese até testar o botão do detetor
# SETPOINT_C=21                            # config/home.json pode sobrepor por divisão
# HOME_CONFIG_FILE=config/home.json        # divisões simuladas e parâmetros por divisão
# STORE_INTERVAL_S=30                      # histórico em var/history.db (SQLite)
# HISTORY_DB=var/history.db             # var/history_sim.db com SIMULATE=true
# LAYOUT_FILE=config/layout.json          # gémeo digital 3D (scripts/layout_init.py)
# --- Agentes A2A (Coordenador, Segurança, Energia, Conforto) ---
# AGENTS=true                 # a API envia eventos aos agentes por A2A (false = só perceção + emergência)
# AGENTS_HOST=127.0.0.1
# AGENTS_BASE_PORT=9100       # Coordenador 9100, Segurança 9101, Energia 9102, Conforto 9103
# AGENT_TIMEOUT_S=120
# AGENT_COOLDOWN_S=60
# API_URL=http://127.0.0.1:8000   # onde as ferramentas (só leitura) dos agentes leem a casa
